#!/bin/sh
# Copyright (c) 2026 TLA Lab. All rights reserved. Proprietary and confidential; see LICENSE.
# Runs SAI's multi-model plugin in place from the SAI repository checkout ($SAI_REPO); the plugin reaches SAI Core
# through `python -m sai.cli` in that same checkout. Nothing is installed or copied.
: "${SAI_REPO:?set SAI_REPO to the folder of your SAI compiler checkout}"
PY="${SAI_PYTHON:-python3}"
export PYTHONPATH="$SAI_REPO/extensions/sai_multimodel/src:$SAI_REPO:$SAI_REPO/converter${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1
export SAI_MULTIMODEL_SAI_CMD="[\"$PY\", \"-m\", \"sai.cli\"]" SAI_MULTIMODEL_SAI_CWD="$SAI_REPO"
exec "$PY" -m sai_multimodel "$@"
